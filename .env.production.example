# Copy to .env.production and fill in. Never commit the copy.

# Public addresses (Caddy gets HTTPS certificates for plain hostnames)
WEB_ADDRESS=app.example.com
API_ADDRESS=api.example.com
WEB_URL=https://app.example.com
API_URL=https://api.example.com
# Parent domain so the web app sees the API's session cookie
COOKIE_DOMAIN=example.com
ACME_EMAIL=you@example.com

# Secrets: openssl rand -base64 32
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
METRICS_TOKEN=
ADMIN_EMAILS=you@example.com

# Storage, option A: Cloudflare R2 (recommended; free egress)
#   Create a bucket and an API token with read/write; connect a custom domain
#   (e.g. media.example.com) to the bucket for public playback.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=vidflow
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_BASE_URL=https://media.example.com
S3_PUBLIC_READ_POLICY=false

# Storage, option B: self-hosted RustFS (start with --profile storage)
# S3_ENDPOINT=http://storage:9000
# S3_PRESIGN_ENDPOINT=https://media.example.com
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_BASE_URL=https://media.example.com/vidflow
# S3_PUBLIC_READ_POLICY=true
# MEDIA_ADDRESS=media.example.com

# Capacity
TRANSCODE_REPLICAS=2
TRANSCODE_CPUS=2
FFMPEG_PRESET=veryfast
UPLOADS_PER_HOUR=30
MAX_ACTIVE_VIDEOS=5
