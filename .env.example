# Copy to .env and adjust. Both apps read this file.

# API
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vidflow
REDIS_URL=redis://localhost:6379
# Redis key prefix for BullMQ queues
QUEUE_PREFIX=vidflow
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-32-character-string

# Object storage (S3-compatible). Local: RustFS from docker-compose.
# Cloudflare R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto,
#   S3_FORCE_PATH_STYLE=false, S3_PUBLIC_BASE_URL=https://media.example.com, S3_PUBLIC_READ_POLICY=false
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=vidflow
S3_ACCESS_KEY_ID=vidflow
S3_SECRET_ACCESS_KEY=vidflow-secret-key
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:9000/vidflow
S3_PUBLIC_READ_POLICY=true

# Workers
PROBE_CONCURRENCY=4
# Longest accepted video, in ms (4 hours)
MAX_DURATION_MS=14400000
# FFPROBE_PATH=/usr/bin/ffprobe
# FFMPEG_PATH=/usr/bin/ffmpeg
# Encodes at once per transcode worker (x264 already uses every core)
TRANSCODE_CONCURRENCY=1
FFMPEG_PRESET=veryfast
# FFMPEG_THREADS=0
# TRANSCODE_TMP_DIR=/tmp
PACKAGE_CONCURRENCY=4
# Keep encoded MP4s in work/ after packaging
KEEP_RENDITION_MP4=false
THUMBNAIL_CONCURRENCY=2
NOTIFY_CONCURRENCY=10
# Let webhooks reach localhost/private networks. Development only!
WEBHOOK_ALLOW_PRIVATE=true

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
