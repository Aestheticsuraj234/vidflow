{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": ["DATABASE_URL", "REDIS_URL", "BETTER_AUTH_SECRET", "WEB_URL", "S3_*"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "dependsOn": ["@vidflow/db#db:migrate", "@vidflow/storage#storage:setup"],
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "storage:setup": {
      "cache": false
    }
  }
}
