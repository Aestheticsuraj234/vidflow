    "pg": "^8.23.1",
    "zod": "^4.6.7",
    "@vidflow/db": "workspace:*",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@vidflow/tsconfig": "workspace:*",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
