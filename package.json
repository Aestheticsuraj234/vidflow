{
  "name": "vidflow",
  "private": true,
  "description": "Scalable video transcoding pipeline with microservices and BullMQ",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @vidflow/db db:migrate",
    "setup": "docker compose up -d && pnpm db:migrate && pnpm storage:setup",
    "storage:setup": "pnpm --filter @vidflow/storage storage:setup",
    "smoke": "./scripts/smoke-api.sh",
    "db:generate": "pnpm --filter @vidflow/db db:generate",
    "queues:stats": "pnpm --filter @vidflow/queues queues:stats",
    "queues:replay": "pnpm --filter @vidflow/queues queues:replay",
    "test:chaos": "pnpm --filter @vidflow/chaos-tests test:chaos"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.0.0",
    "prettier": "^3.10.1",
    "turbo": "^2.11.11",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.0.0"
  }
}
