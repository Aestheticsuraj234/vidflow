      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queue) (increase(vidflow_jobs_stalled_total[5m])) or on() vector(0)",
          "legendFormat": "{{queue}}"
        }
      ],
      "id": 12
    },
    {
